[Unit]
Description=Angebots-Bot (Discord, Marktguru)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moltbook
WorkingDirectory=/home/moltbook/angebots-bot
ExecStart=/home/moltbook/angebots-bot/.venv/bin/python discord_bot.py
Restart=on-failure
RestartSec=30
# Wenig RAM auf dem VPS: hart begrenzen
MemoryMax=200M

[Install]
WantedBy=multi-user.target
