# Kopieren nach .env und ausfüllen

# Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=

# ID deines Discord-Servers (Rechtsklick auf Server -> Server-ID kopieren).
# Gesetzt = Befehle sind sofort und nur auf diesem Server da.
GUILD_ID=

# Deine eigene Discord-User-ID. Damit benutzen CLI und Hermes dieselben
# Einstellungen und Alarme wie du im Discord, und die DMs kommen bei dir an.
CLI_USER_ID=

# Standardwerte für neue Nutzer
STANDARD_PLZ=42579
STANDARD_MAERKTE=aldi-nord,aldi-sued,rewe,netto,lidl,kaufland,edeka

# Tägliche Alarmprüfung
PRUEFZEIT=06:30
ZEITZONE=Europe/Berlin

# Optional
# MAX_ALARME=25
# CACHE_SEKUNDEN=1800
# DB_PFAD=/home/moltbook/angebots-bot/angebote.db
# Nur falls das automatische Auslesen von marktguru.de mal nicht klappt:
# MARKTGURU_APIKEY=
# MARKTGURU_CLIENTKEY=
